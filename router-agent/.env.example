# ChoreKey enforcement agent — copy to .env and fill in. NEVER commit the real .env.
# Secrets (AdGuard/router passwords, Supabase service key) stay on this host only.

# ---- Enforcement backend ----
# adguard = block devices via AdGuard Home DNS (reliable, recommended)
# router  = TP-Link HB210 Access Control (best-effort; firmware blocks scripted
#           enforcing rules — see README "Status")
# both    = run both
ENFORCE_BACKEND=adguard

# ---- AdGuard Home (used when backend is adguard/both) ----
# Admin URL of your AdGuard Home instance (the web UI address).
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# ---- Router (used when backend is router/both) ----
ROUTER_HOST=192.168.88.1
# Internal admin login name — "user" on the HB210 Pro's single-admin firmware.
ROUTER_USERNAME=user
ROUTER_PASSWORD=
ROUTER_RSA_PADDING=none

# ---- Supabase ----
SUPABASE_URL=https://qkjpxrzbzxxjevxrgfgd.supabase.co
# Service-role key (bypasses RLS). Local to this host only — do not commit.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: restrict enforcement to one family_id. Empty = all families visible.
FAMILY_ID=

# ---- Behavior ----
# Reconcile backstop interval (seconds). Realtime nudges also trigger reconciles.
POLL_INTERVAL_SECONDS=30
# DRY_RUN=true computes + logs the desired block set but never writes to a backend.
DRY_RUN=false
# Treat devices.schedule_start/end as a BLOCK window (block INSIDE it, e.g. a
# 22:00-06:00 bedtime curfew). Set true to instead treat it as an ALLOWED window.
SCHEDULE_IS_ALLOWED_WINDOW=false
# Log level: debug | info | warn | error
LOG_LEVEL=info
