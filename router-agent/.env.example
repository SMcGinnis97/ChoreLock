# ChoreKey router agent — copy to .env and fill in. NEVER commit the real .env.
# The router password and Supabase service key stay on this host only.

# ---- Router (TP-Link HB210 Pro) ----
ROUTER_HOST=192.168.88.1
# Internal admin login name. On the HB210 Pro's single-admin firmware this is
# "user" (verified live), even though the web UI shows only a password box.
ROUTER_USERNAME=user
# Admin password for the router web UI. Supplied at runtime on this host only.
ROUTER_PASSWORD=
# RSA signature padding for the cgi_gdpr handshake: "none" (raw/NOPADDING, proven
# on this firmware family) or "pkcs1". Leave as none unless login fails.
ROUTER_RSA_PADDING=none

# ---- Supabase ----
SUPABASE_URL=https://qkjpxrzbzxxjevxrgfgd.supabase.co
# Service-role key (bypasses RLS). Local to this host only — do not commit.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: restrict enforcement to one family_id. Empty = all families visible.
FAMILY_ID=

# ---- Behavior ----
# Reconcile backstop interval (seconds). Realtime nudges trigger reconciles too.
POLL_INTERVAL_SECONDS=30
# DRY_RUN=true computes and logs the desired deny list but never writes to the router.
DRY_RUN=false
# Treat devices.schedule_start/end as a BLOCK window (block INSIDE it, e.g. a
# 22:00-06:00 bedtime curfew). Set true to instead treat it as an ALLOWED window.
SCHEDULE_IS_ALLOWED_WINDOW=false
# Log level: debug | info | warn | error
LOG_LEVEL=info
